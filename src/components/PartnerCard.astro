---
interface Props {
  title: string;
  body: string;
  cta: string;
  href: string;
  partner?: string;
  iconPath: string;
}
const { title, body, cta, href, partner, iconPath } = Astro.props;
---

<article class="card p-6 md:p-7 flex flex-col h-full hover:shadow-lg transition">
  <span class="inline-flex items-center justify-center w-12 h-12 rounded-2xl bg-jungle-50 text-jungle-700 mb-4">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d={iconPath} />
    </svg>
  </span>
  <h3 class="font-display text-xl text-ink mb-2">{title}</h3>
  <p class="text-ink-soft text-[15px] mb-5 flex-1">{body}</p>
  <a
    href={href}
    target="_blank"
    rel="sponsored nofollow noopener"
    class="inline-flex items-center gap-1.5 text-jungle-700 hover:text-jungle-500 font-medium text-sm no-underline"
  >
    {cta}
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <line x1="5" y1="12" x2="19" y2="12" />
      <polyline points="12 5 19 12 12 19" />
    </svg>
    {partner && <span class="sr-only">(affiliate link to {partner})</span>}
  </a>
</article>
