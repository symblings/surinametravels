---
interface Props {
  href: string;
  variant?: 'inline' | 'button';
  /** Optional partner name shown as a small disclosure badge */
  partner?: string;
}
const { href, variant = 'inline', partner } = Astro.props;
---

{
  variant === 'button' ? (
    <a
      href={href}
      target="_blank"
      rel="sponsored nofollow noopener"
      class="btn-primary text-sm"
    >
      <slot />
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M14 3h7v7M21 3l-9 9M21 14v6a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h6" />
      </svg>
      {partner && <span class="sr-only">(affiliate link to {partner})</span>}
    </a>
  ) : (
    <a
      href={href}
      target="_blank"
      rel="sponsored nofollow noopener"
      class="underline decoration-leaf-500 decoration-2 underline-offset-2 hover:text-jungle-500"
    >
      <slot />
      {partner && <span class="sr-only">(affiliate link to {partner})</span>}
    </a>
  )
}
