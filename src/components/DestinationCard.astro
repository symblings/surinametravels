---
interface Props {
  name: string;
  region: string;
  image: string;
  alt: string;
  highlight?: string;
}
const { name, region, image, alt, highlight } = Astro.props;
---

<article class="group relative rounded-3xl overflow-hidden h-72 shadow-card">
  <img
    src={image}
    alt={alt}
    width="600"
    height="500"
    class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
    loading="lazy"
  />
  <div class="absolute inset-0 bg-gradient-to-t from-jungle-900/85 via-jungle-900/20 to-transparent"></div>
  <div class="absolute inset-x-0 bottom-0 p-5 text-white">
    {highlight && <span class="inline-block text-[10px] uppercase tracking-widest font-semibold text-leaf-400 mb-2">{highlight}</span>}
    <h3 class="font-display text-2xl leading-tight">{name}</h3>
    <p class="text-sm text-jungle-50/85 mt-0.5">{region}</p>
  </div>
</article>
