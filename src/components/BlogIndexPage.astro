---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import PostCard from '@components/PostCard.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import { useTranslations, routeFor, readingTime, type Lang } from '@i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const allPosts = (await getCollection('posts', ({ data }) => data.lang === lang && !data.draft))
  .sort((a, b) => +b.data.publishDate - +a.data.publishDate)
  .map((p) => ({
    slug: p.id.replace(/^[a-z]{2}\//, ''),
    title: p.data.title,
    description: p.data.description,
    publishDate: p.data.publishDate,
    heroImage: typeof p.data.heroImage === 'string' ? p.data.heroImage : (p.data.heroImage as { src: string }).src,
    heroAlt: p.data.heroAlt,
    category: p.data.category,
    tags: p.data.tags,
    featured: p.data.featured,
    readingMinutes: readingTime(p.body ?? ''),
  }));

const featured = allPosts.find((p) => p.featured) ?? allPosts[0];
const rest = allPosts.filter((p) => p.slug !== featured?.slug);

const allCategories = Array.from(new Set(allPosts.map((p) => p.category)));

const canonical = routeFor(lang, 'blog');
const alternates = [
  { lang: 'nl' as Lang, href: '/blog/' },
  { lang: 'en' as Lang, href: '/en/blog/' },
];
---

<BaseLayout
  title={lang === 'nl' ? 'Blog — Reisverhalen uit Suriname | Suriname Travels' : 'Blog — Stories from Suriname | Suriname Travels'}
  description={t('blog.subtitle')}
  lang={lang}
  canonical={canonical}
  alternates={alternates}
>
  <section class="container-narrow pt-10 md:pt-14">
    <Breadcrumbs items={[
      { label: t('nav.home'), href: routeFor(lang, 'home') },
      { label: t('nav.blog') },
    ]} />
    <div class="mt-6 max-w-2xl">
      <h1 class="font-display text-4xl md:text-5xl lg:text-6xl text-ink leading-[1.05]">{t('blog.title')}</h1>
      <p class="mt-4 text-lg text-ink-soft">{t('blog.subtitle')}</p>
    </div>
  </section>

  {featured && (
    <section class="container-narrow mt-12 md:mt-16">
      <div class="flex items-center gap-2 mb-4">
        <span class="pill bg-leaf-500/20 text-leaf-600">{t('blog.featuredLabel')}</span>
      </div>
      <PostCard post={featured} lang={lang} variant="featured" />
    </section>
  )}

  {allCategories.length > 1 && (
    <section class="container-narrow mt-14">
      <div class="flex flex-wrap gap-2" data-tag-filter>
        <button data-filter="all" class="pill bg-jungle-700 text-white" aria-pressed="true">{t('blog.allTags')}</button>
        {allCategories.map((c) => (
          <button data-filter={c} class="pill bg-mist text-ink-soft hover:bg-jungle-50 hover:text-jungle-700" aria-pressed="false">{c}</button>
        ))}
      </div>
    </section>
  )}

  <section class="container-narrow py-10 md:py-14">
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3" data-post-grid>
      {rest.length > 0 ? rest.map((post) => (
        <div data-category={post.category}>
          <PostCard post={post} lang={lang} />
        </div>
      )) : (
        <p class="text-ink-soft col-span-full">{t('blog.empty')}</p>
      )}
    </div>
  </section>
</BaseLayout>

<script>
  const filterContainer = document.querySelector('[data-tag-filter]');
  const grid = document.querySelector('[data-post-grid]');
  if (filterContainer && grid) {
    filterContainer.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const button = target.closest('button[data-filter]') as HTMLButtonElement | null;
      if (!button) return;
      const filter = button.dataset.filter;
      if (!filter) return;

      filterContainer.querySelectorAll('button[data-filter]').forEach((b) => {
        b.classList.remove('bg-jungle-700', 'text-white');
        b.classList.add('bg-mist', 'text-ink-soft', 'hover:bg-jungle-50', 'hover:text-jungle-700');
        b.setAttribute('aria-pressed', 'false');
      });
      button.classList.add('bg-jungle-700', 'text-white');
      button.classList.remove('bg-mist', 'text-ink-soft', 'hover:bg-jungle-50', 'hover:text-jungle-700');
      button.setAttribute('aria-pressed', 'true');

      grid.querySelectorAll<HTMLElement>('[data-category]').forEach((card) => {
        const show = filter === 'all' || card.dataset.category === filter;
        card.style.display = show ? '' : 'none';
      });
    });
  }
</script>
