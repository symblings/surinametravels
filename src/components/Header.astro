---
import { useTranslations, routeFor, type Lang } from '@i18n/utils';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  lang: Lang;
  alternateUrl?: string;
  /** When true, header renders in dark cinematic variant. */
  dark?: boolean;
}

const { lang, alternateUrl, dark = false } = Astro.props;
const isDark = dark;
const t = useTranslations(lang);

const navItems = [
  { label: t('nav.home'), href: routeFor(lang, 'home') },
  { label: t('nav.blog'), href: routeFor(lang, 'blog') },
  { label: t('nav.services'), href: routeFor(lang, 'services') },
];

const currentPath = Astro.url.pathname;
function isActive(href: string) {
  if (href === routeFor(lang, 'home')) return currentPath === href;
  return currentPath.startsWith(href);
}
---

<a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:bg-white focus:p-2 focus:rounded">
  {t('a11y.skipToContent')}
</a>

<header
  class={`sticky top-0 z-40 backdrop-blur transition-colors duration-200 border-b ${
    isDark
      ? 'bg-jungle-900/80 border-white/10'
      : 'bg-sand/85 border-mist'
  }`}
>
  <div class="container-narrow flex items-center justify-between py-4">
    <a href={routeFor(lang, 'home')} class="flex items-center group" aria-label="Suriname Travels — home">
      <img
        src="/brand/suriname-travels-beeldmerk.png"
        alt=""
        aria-hidden="true"
        width="40"
        height="40"
        class={`md:hidden h-9 w-auto ${isDark ? 'logo-dark-mode' : ''}`}
        loading="eager"
      />
      <img
        src="/brand/surinametravels-logo-transparant.png"
        alt=""
        aria-hidden="true"
        width="220"
        height="56"
        class={`hidden md:block h-10 w-auto ${isDark ? 'logo-dark-mode' : ''}`}
        loading="eager"
      />
    </a>

    <nav class="hidden md:flex items-center gap-1" aria-label="Primary">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class={`px-3 py-2 rounded-full text-sm font-medium transition ${
              isActive(item.href)
                ? (isDark ? 'bg-white/10 text-white' : 'bg-jungle-50 text-jungle-700')
                : (isDark
                    ? 'text-white/85 hover:text-white hover:bg-white/10'
                    : 'text-ink-soft hover:text-jungle-700 hover:bg-jungle-50/60')
            }`}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-3">
      <LanguageSwitcher lang={lang} alternateUrl={alternateUrl} />
      <a href={routeFor(lang, 'services')} class="hidden md:inline-flex btn-primary text-sm" style="padding: 0.625rem 1.25rem;">
        {t('hero.cta.secondary')}
      </a>
      <button
        id="nav-toggle"
        class={`md:hidden p-2 rounded-full ${isDark ? 'text-white hover:bg-white/10' : 'text-ink hover:bg-jungle-50'}`}
        aria-label={t('a11y.menu')}
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6" />
          <line x1="3" y1="12" x2="21" y2="12" />
          <line x1="3" y1="18" x2="21" y2="18" />
        </svg>
      </button>
    </div>
  </div>

  <nav id="mobile-nav" class={`md:hidden hidden border-t ${isDark ? 'border-white/10 bg-jungle-900' : 'border-mist bg-white'}`} aria-label="Mobile">
    <div class="container-narrow py-3 flex flex-col gap-1">
      {
        navItems.map((item) => (
          <a href={item.href} class={`px-3 py-2.5 rounded-lg ${isDark ? 'text-white hover:bg-white/10' : 'text-ink hover:bg-jungle-50'}`}>
            {item.label}
          </a>
        ))
      }
    </div>
  </nav>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('mobile-nav');
  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
  });
</script>
